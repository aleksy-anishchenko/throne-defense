{
  // Логика игры: только чистый JavaScript.
  // В "lib" нет "DOM", а "types" пустой — значит, нет ни document/window, ни API Node.
  // Если логика случайно полезет в браузер, TypeScript выдаст ошибку.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    // Только тот TypeScript, который Node умеет запускать напрямую (без enum и т.п.)
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src"]
}
