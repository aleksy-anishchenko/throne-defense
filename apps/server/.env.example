# Пример настроек сервера. Скопируй в .env рядом (cp .env.example .env) и поправь под себя.
# .env в git не попадает: там будут секреты. Сюда — только безопасные примеры.

# Порт API. Сервер слушает только 127.0.0.1 — снаружи к нему ходят через nginx (/api/ → 127.0.0.1:3000)
PORT=3000

# Файл базы SQLite (понадобится с шага 3.6). Относительный путь — от папки apps/server
DATABASE_PATH=./data/throne.db
